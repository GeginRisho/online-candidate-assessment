generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  fullName      String         @map("full_name")
  role          AdminRole      @default(RECRUITER)
  isActive      Boolean        @default(true) @map("is_active")
  lastLoginAt   DateTime?      @map("last_login_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  auditLogs     AuditLog[]
  createdExams  Exam[]         @relation("ExamCreatedBy")
  questions     Question[]     @relation("QuestionCreatedBy")
  refreshTokens RefreshToken[]

  @@index([email])
  @@map("admins")
}

model Candidate {
  id                String          @id @default(uuid())
  candidateCode     String          @unique @map("candidate_code")
  email             String          @unique
  phone             String?
  fullName          String          @map("full_name")
  passwordHash      String?         @map("password_hash")
  collegeName       String?         @map("college_name")
  degree            String?
  branch            String?
  graduationYear    Int?            @map("graduation_year")
  resumeUrl         String?         @map("resume_url")
  photoUrl          String?         @map("photo_url")
  status            CandidateStatus @default(REGISTERED)
  qrToken           String?         @unique @map("qr_token")
  systemCheckPassed Boolean         @default(false) @map("system_check_passed")
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  answers           Answer[]
  auditLogs         AuditLog[]
  examSessions      ExamSession[]
  refreshTokens     RefreshToken[]
  results           Result[]
  warnings          Warning[]

  @@index([email])
  @@index([status])
  @@index([candidateCode])
  @@map("candidates")
}

model RefreshToken {
  id          String     @id @default(uuid())
  tokenHash   String     @unique @map("token_hash")
  adminId     String?    @map("admin_id")
  candidateId String?    @map("candidate_id")
  expiresAt   DateTime   @map("expires_at")
  revokedAt   DateTime?  @map("revoked_at")
  userAgent   String?    @map("user_agent")
  ipAddress   String?    @map("ip_address")
  createdAt   DateTime   @default(now()) @map("created_at")
  admin       Admin?     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([candidateId])
  @@map("refresh_tokens")
}

model Question {
  id            String          @id @default(uuid())
  type          QuestionType
  format        QuestionFormat  @default(MCQ_SINGLE)
  domain        String
  topic         String?
  difficulty    DifficultyLevel @default(MEDIUM)
  text          String
  codeSnippet   String?         @map("code_snippet")
  options       Json?
  correctAnswer Json            @map("correct_answer")
  explanation   String?
  marks         Int             @default(1)
  negativeMarks Float           @default(0) @map("negative_marks")
  timeLimitSec  Int?            @map("time_limit_sec")
  tags          String[]
  isActive      Boolean         @default(true) @map("is_active")
  createdById   String          @map("created_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  answers       Answer[]
  examQuestions ExamQuestion[]
  createdBy     Admin           @relation("QuestionCreatedBy", fields: [createdById], references: [id])

  @@index([type, domain, difficulty])
  @@index([isActive])
  @@map("questions")
}

model Exam {
  id                     String         @id @default(uuid())
  title                  String
  description            String?
  status                 ExamStatus     @default(DRAFT)
  aptitudeDurationSec    Int            @map("aptitude_duration_sec")
  technicalDurationSec   Int            @map("technical_duration_sec")
  aptitudeQuestionCount  Int            @map("aptitude_question_count")
  technicalQuestionCount Int            @map("technical_question_count")
  passingScorePercent    Float          @default(40) @map("passing_score_percent")
  maxWarnings            Int            @default(3) @map("max_warnings")
  autoDisqualifyEnabled  Boolean        @default(true) @map("auto_disqualify_enabled")
  requireFullscreen      Boolean        @default(true) @map("require_fullscreen")
  requireCamera          Boolean        @default(true) @map("require_camera")
  shuffleQuestions       Boolean        @default(true) @map("shuffle_questions")
  shuffleOptions         Boolean        @default(true) @map("shuffle_options")
  scheduledStart         DateTime?      @map("scheduled_start")
  scheduledEnd           DateTime?      @map("scheduled_end")
  createdById            String         @map("created_by_id")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  examQuestions          ExamQuestion[]
  sessions               ExamSession[]
  createdBy              Admin          @relation("ExamCreatedBy", fields: [createdById], references: [id])

  @@index([status])
  @@map("exams")
}

model ExamQuestion {
  id         String   @id @default(uuid())
  examId     String   @map("exam_id")
  questionId String   @map("question_id")
  order      Int      @default(0)
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@index([examId])
  @@map("exam_questions")
}

model ExamSession {
  id                 String            @id @default(uuid())
  examId             String            @map("exam_id")
  candidateId        String            @map("candidate_id")
  status             ExamSessionStatus @default(NOT_STARTED)
  startedAt          DateTime?         @map("started_at")
  endedAt            DateTime?         @map("ended_at")
  aptitudeStartedAt  DateTime?         @map("aptitude_started_at")
  aptitudeEndedAt    DateTime?         @map("aptitude_ended_at")
  technicalStartedAt DateTime?         @map("technical_started_at")
  technicalEndedAt   DateTime?         @map("technical_ended_at")
  lastHeartbeatAt    DateTime?         @map("last_heartbeat_at")
  warningCount       Int               @default(0) @map("warning_count")
  isDisqualified     Boolean           @default(false) @map("is_disqualified")
  disqualifyReason   String?           @map("disqualify_reason")
  browserInfo        Json?             @map("browser_info")
  ipAddress          String?           @map("ip_address")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  answers            Answer[]
  candidate          Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  exam               Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  result             Result?
  warnings           Warning[]

  @@unique([examId, candidateId])
  @@index([status])
  @@index([candidateId])
  @@map("exam_sessions")
}

model Answer {
  id              String      @id @default(uuid())
  examSessionId   String      @map("exam_session_id")
  candidateId     String      @map("candidate_id")
  questionId      String      @map("question_id")
  selectedOptions Json?       @map("selected_options")
  codeAnswer      String?     @map("code_answer")
  textAnswer      String?     @map("text_answer")
  isCorrect       Boolean?    @map("is_correct")
  marksAwarded    Float?      @map("marks_awarded")
  timeSpentSec    Int         @default(0) @map("time_spent_sec")
  isFlagged       Boolean     @default(false) @map("is_flagged")
  isAutoSaved     Boolean     @default(false) @map("is_auto_saved")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  candidate       Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  examSession     ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  question        Question    @relation(fields: [questionId], references: [id])

  @@unique([examSessionId, questionId])
  @@index([examSessionId])
  @@map("answers")
}

model Result {
  id              String       @id @default(uuid())
  examSessionId   String       @unique @map("exam_session_id")
  candidateId     String       @map("candidate_id")
  aptitudeScore   Float        @default(0) @map("aptitude_score")
  technicalScore  Float        @default(0) @map("technical_score")
  totalScore      Float        @default(0) @map("total_score")
  totalMarks      Float        @default(0) @map("total_marks")
  percentage      Float        @default(0)
  correctCount    Int          @default(0) @map("correct_count")
  incorrectCount  Int          @default(0) @map("incorrect_count")
  unansweredCount Int          @default(0) @map("unanswered_count")
  status          ResultStatus @default(PENDING_REVIEW)
  durationSec     Int          @default(0) @map("duration_sec")
  rank            Int?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  candidate       Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  examSession     ExamSession  @relation(fields: [examSessionId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([status])
  @@map("results")
}

model Warning {
  id            String          @id @default(uuid())
  examSessionId String          @map("exam_session_id")
  candidateId   String          @map("candidate_id")
  type          WarningType
  severity      WarningSeverity @default(MEDIUM)
  message       String
  metadata      Json?
  createdAt     DateTime        @default(now()) @map("created_at")
  candidate     Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  examSession   ExamSession     @relation(fields: [examSessionId], references: [id], onDelete: Cascade)

  @@index([examSessionId])
  @@index([candidateId])
  @@map("warnings")
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id          String      @id @default(uuid())
  action      AuditAction
  entity      AuditEntity
  entityId    String?     @map("entity_id")
  adminId     String?     @map("admin_id")
  candidateId String?     @map("candidate_id")
  description String?
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  admin       Admin?      @relation(fields: [adminId], references: [id])
  candidate   Candidate?  @relation(fields: [candidateId], references: [id])

  @@index([entity, entityId])
  @@index([adminId])
  @@index([candidateId])
  @@map("audit_logs")
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  RECRUITER
  PROCTOR
}

enum CandidateStatus {
  REGISTERED
  VERIFIED
  IN_PROGRESS
  SUBMITTED
  DISQUALIFIED
  COMPLETED
  ABSENT
}

enum QuestionType {
  APTITUDE
  TECHNICAL
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum QuestionFormat {
  MCQ_SINGLE
  MCQ_MULTIPLE
  TRUE_FALSE
  CODING
  DESCRIPTIVE
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ExamSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  SUBMITTED
  AUTO_SUBMITTED
  DISQUALIFIED
  EXPIRED
}

enum WarningType {
  TAB_SWITCH
  WINDOW_BLUR
  FULLSCREEN_EXIT
  COPY_ATTEMPT
  PASTE_ATTEMPT
  RIGHT_CLICK
  MULTIPLE_FACES
  NO_FACE_DETECTED
  DEVTOOLS_OPENED
  SCREEN_SHARE_DETECTED
  PROHIBITED_KEY
  NETWORK_DISCONNECT
  OTHER
}

enum WarningSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ResultStatus {
  PASS
  FAIL
  PENDING_REVIEW
  DISQUALIFIED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  IMPORT
  EXPORT
  SUBMIT
  DISQUALIFY
  OTHER
}

enum AuditEntity {
  CANDIDATE
  ADMIN
  QUESTION
  EXAM
  EXAM_SESSION
  ANSWER
  RESULT
  WARNING
  SETTINGS
}
