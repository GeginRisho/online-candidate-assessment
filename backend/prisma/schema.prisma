// ============================================================================
// Online Candidate Assessment Platform — Prisma Schema
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"

}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum CandidateStatus {
  REGISTERED
  VERIFIED
  IN_PROGRESS
  SUBMITTED
  DISQUALIFIED
  COMPLETED
  ABSENT
}

enum QuestionType {
  APTITUDE
  TECHNICAL
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum QuestionFormat {
  MCQ_SINGLE
  MCQ_MULTIPLE
  TRUE_FALSE
  CODING
  DESCRIPTIVE
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ExamSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  SUBMITTED
  AUTO_SUBMITTED
  DISQUALIFIED
  EXPIRED
}

enum WarningType {
  TAB_SWITCH
  WINDOW_BLUR
  FULLSCREEN_EXIT
  COPY_ATTEMPT
  PASTE_ATTEMPT
  RIGHT_CLICK
  MULTIPLE_FACES
  NO_FACE_DETECTED
  DEVTOOLS_OPENED
  SCREEN_SHARE_DETECTED
  PROHIBITED_KEY
  NETWORK_DISCONNECT
  OTHER
}

enum WarningSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ResultStatus {
  PASS
  FAIL
  PENDING_REVIEW
  DISQUALIFIED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  IMPORT
  EXPORT
  SUBMIT
  DISQUALIFY
  OTHER
}

enum AuditEntity {
  CANDIDATE
  ADMIN
  QUESTION
  EXAM
  EXAM_SESSION
  ANSWER
  RESULT
  WARNING
  SETTINGS
}

// ----------------------------------------------------------------------------
// CORE IDENTITY MODELS
// ----------------------------------------------------------------------------

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         AdminRole @default(RECRUITER)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")

  refreshTokens RefreshToken[]
  createdExams  Exam[]         @relation("ExamCreatedBy")
  questions     Question[]     @relation("QuestionCreatedBy")
  auditLogs     AuditLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("admins")
}

model Candidate {
  id               String          @id @default(uuid())
  candidateCode    String          @unique @map("candidate_code") // used for QR registration lookup
  email            String          @unique
  phone            String?
  fullName         String          @map("full_name")
  passwordHash     String?         @map("password_hash")
  collegeName      String?         @map("college_name")
  degree           String?
  branch           String?
  graduationYear   Int?            @map("graduation_year")
  resumeUrl        String?         @map("resume_url")
  photoUrl         String?         @map("photo_url")
  status           CandidateStatus @default(REGISTERED)
  qrToken          String?         @unique @map("qr_token")
  systemCheckPassed Boolean        @default(false) @map("system_check_passed")
  metadata         Json?           // arbitrary custom-field capture (batch, department, etc.)

  refreshTokens RefreshToken[]
  examSessions  ExamSession[]
  answers       Answer[]
  results       Result[]
  warnings      Warning[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([status])
  @@index([candidateCode])
  @@map("candidates")
}

model RefreshToken {
  id          String     @id @default(uuid())
  tokenHash   String     @unique @map("token_hash")
  adminId     String?    @map("admin_id")
  candidateId String?    @map("candidate_id")
  expiresAt   DateTime   @map("expires_at")
  revokedAt   DateTime?  @map("revoked_at")
  userAgent   String?    @map("user_agent")
  ipAddress   String?    @map("ip_address")

  admin     Admin?     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  candidate Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([candidateId])
  @@map("refresh_tokens")
}

// ----------------------------------------------------------------------------
// QUESTION BANK
// ----------------------------------------------------------------------------

model Question {
  id            String          @id @default(uuid())
  type          QuestionType
  format        QuestionFormat  @default(MCQ_SINGLE)
  domain        String          // e.g. "Java", "Quantitative Aptitude", "DBMS"
  topic         String?
  difficulty    DifficultyLevel @default(MEDIUM)
  text          String          @db.Text
  codeSnippet   String?         @map("code_snippet") @db.Text
  options       Json?           // [{ id, text }] for MCQ types
  correctAnswer Json            @map("correct_answer") // string[] of option ids, or expected output for coding
  explanation   String?         @db.Text
  marks         Int             @default(1)
  negativeMarks Float           @default(0) @map("negative_marks")
  timeLimitSec  Int?            @map("time_limit_sec")
  tags          String[]
  isActive      Boolean         @default(true) @map("is_active")

  createdById String @map("created_by_id")
  createdBy   Admin  @relation("QuestionCreatedBy", fields: [createdById], references: [id])

  examQuestions ExamQuestion[]
  answers       Answer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type, domain, difficulty])
  @@index([isActive])
  @@map("questions")
}

// ----------------------------------------------------------------------------
// EXAM CONFIGURATION
// ----------------------------------------------------------------------------

model Exam {
  id                     String     @id @default(uuid())
  title                  String
  description            String?    @db.Text
  status                 ExamStatus @default(DRAFT)
  aptitudeDurationSec    Int        @map("aptitude_duration_sec")
  technicalDurationSec   Int        @map("technical_duration_sec")
  aptitudeQuestionCount  Int        @map("aptitude_question_count")
  technicalQuestionCount Int        @map("technical_question_count")
  passingScorePercent    Float      @default(40) @map("passing_score_percent")
  maxWarnings            Int        @default(3) @map("max_warnings")
  autoDisqualifyEnabled  Boolean    @default(true) @map("auto_disqualify_enabled")
  requireFullscreen      Boolean    @default(true) @map("require_fullscreen")
  requireCamera          Boolean    @default(true) @map("require_camera")
  shuffleQuestions       Boolean    @default(true) @map("shuffle_questions")
  shuffleOptions         Boolean    @default(true) @map("shuffle_options")
  scheduledStart         DateTime?  @map("scheduled_start")
  scheduledEnd           DateTime?  @map("scheduled_end")

  createdById String @map("created_by_id")
  createdBy   Admin  @relation("ExamCreatedBy", fields: [createdById], references: [id])

  examQuestions ExamQuestion[]
  sessions      ExamSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("exams")
}

model ExamQuestion {
  id         String @id @default(uuid())
  examId     String @map("exam_id")
  questionId String @map("question_id")
  order      Int    @default(0)

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@index([examId])
  @@map("exam_questions")
}

// ----------------------------------------------------------------------------
// EXAM SESSION / ATTEMPT
// ----------------------------------------------------------------------------

model ExamSession {
  id                String             @id @default(uuid())
  examId            String             @map("exam_id")
  candidateId       String             @map("candidate_id")
  status            ExamSessionStatus  @default(NOT_STARTED)
  startedAt         DateTime?          @map("started_at")
  endedAt           DateTime?          @map("ended_at")
  aptitudeStartedAt DateTime?          @map("aptitude_started_at")
  aptitudeEndedAt   DateTime?          @map("aptitude_ended_at")
  technicalStartedAt DateTime?         @map("technical_started_at")
  technicalEndedAt  DateTime?          @map("technical_ended_at")
  lastHeartbeatAt   DateTime?          @map("last_heartbeat_at")
  warningCount      Int                @default(0) @map("warning_count")
  isDisqualified    Boolean            @default(false) @map("is_disqualified")
  disqualifyReason  String?            @map("disqualify_reason")
  browserInfo       Json?              @map("browser_info")
  ipAddress         String?            @map("ip_address")

  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  answers   Answer[]
  warnings  Warning[]
  result    Result?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([examId, candidateId])
  @@index([status])
  @@index([candidateId])
  @@map("exam_sessions")
}

model Answer {
  id             String   @id @default(uuid())
  examSessionId  String   @map("exam_session_id")
  candidateId    String   @map("candidate_id")
  questionId     String   @map("question_id")
  selectedOptions Json?   @map("selected_options") // string[] of option ids
  codeAnswer     String?  @map("code_answer") @db.Text
  textAnswer     String?  @map("text_answer") @db.Text
  isCorrect      Boolean? @map("is_correct")
  marksAwarded   Float?   @map("marks_awarded")
  timeSpentSec   Int      @default(0) @map("time_spent_sec")
  isFlagged      Boolean  @default(false) @map("is_flagged")
  isAutoSaved    Boolean  @default(false) @map("is_auto_saved")

  examSession ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([examSessionId, questionId])
  @@index([examSessionId])
  @@map("answers")
}

// ----------------------------------------------------------------------------
// RESULTS
// ----------------------------------------------------------------------------

model Result {
  id                  String       @id @default(uuid())
  examSessionId       String       @unique @map("exam_session_id")
  candidateId         String       @map("candidate_id")
  aptitudeScore       Float        @default(0) @map("aptitude_score")
  technicalScore      Float        @default(0) @map("technical_score")
  totalScore          Float        @default(0) @map("total_score")
  totalMarks          Float        @default(0) @map("total_marks")
  percentage           Float       @default(0)
  correctCount        Int          @default(0) @map("correct_count")
  incorrectCount      Int          @default(0) @map("incorrect_count")
  unansweredCount     Int          @default(0) @map("unanswered_count")
  status              ResultStatus @default(PENDING_REVIEW)
  durationSec         Int          @default(0) @map("duration_sec")
  rank                Int?

  examSession ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([candidateId])
  @@index([status])
  @@map("results")
}

// ----------------------------------------------------------------------------
// ANTI-CHEATING / WARNINGS
// ----------------------------------------------------------------------------

model Warning {
  id            String          @id @default(uuid())
  examSessionId String          @map("exam_session_id")
  candidateId   String          @map("candidate_id")
  type          WarningType
  severity      WarningSeverity @default(MEDIUM)
  message       String
  metadata      Json?

  examSession ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([examSessionId])
  @@index([candidateId])
  @@map("warnings")
}

// ----------------------------------------------------------------------------
// SETTINGS
// ----------------------------------------------------------------------------

model Settings {
  id    String @id @default(uuid())
  key   String @unique
  value Json

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ----------------------------------------------------------------------------
// AUDIT LOG
// ----------------------------------------------------------------------------

model AuditLog {
  id          String      @id @default(uuid())
  action      AuditAction
  entity      AuditEntity
  entityId    String?     @map("entity_id")
  adminId     String?     @map("admin_id")
  candidateId String?     @map("candidate_id")
  description String?     @db.Text
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  metadata    Json?

  admin     Admin?     @relation(fields: [adminId], references: [id])
  candidate Candidate? @relation(fields: [candidateId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([adminId])
  @@index([candidateId])
  @@map("audit_logs")
}
